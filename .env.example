# Copia este archivo a .env y completa los valores.

# Supabase -> Project Settings -> Database -> Connection string
# Conexión con pooling (puerto 6543 en Supabase; aquí se usa el pooler 5432).
DATABASE_URL="postgresql://user:password@host:5432/postgres"
# Conexión directa (puerto 5432), requerida por las migraciones/CLI.
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Genera uno con: npx auth secret   (mínimo 32 caracteres)
AUTH_SECRET="cambia-esto-por-un-secreto-de-32-caracteres-o-mas"
# URL base de la aplicación.
AUTH_URL="http://localhost:3000"

# Nombre público de la aplicación (opcional).
NEXT_PUBLIC_APP_NAME="Galileo EDU"

# --- Correo saliente (opcional) ---
# Si SMTP_HOST no está definido, los correos (recibos, reset de contraseña)
# se registran en la consola en lugar de enviarse.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Galileo EDU <no-reply@galileo.edu.pe>"
SMTP_SECURE="false"

# --- Tareas programadas (opcional) ---
# Secreto compartido para invocar /api/cron/* (cabecera Authorization: Bearer <secreto>).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""
